# Copie para `.env` e ajuste conforme necessário. Todas as variáveis têm um
# valor padrão razoável — só é preciso descomentar o que quiser mudar.

# Porta em que o mptube-server escuta (o nginx faz proxy_pass pra ela).
PORT=8080

# Onde os arquivos baixados ficam temporariamente antes de o usuário baixar
# pelo navegador. Dentro do container isso é /data/downloads (ver docker-compose.yml).
# DOWNLOAD_DIR=/data/downloads

# Depois de quantos minutos um download concluído (e não baixado) é apagado.
RETENTION_MINUTES=30

# Quantos downloads podem rodar ao mesmo tempo no servidor inteiro.
# Em VPS de 1GB de RAM use 2: cada download roda yt-dlp + ffmpeg (merge) e
# pode passar de 200MB de RAM.
MAX_CONCURRENT_DOWNLOADS=2

# Quantos downloads simultâneos um mesmo IP pode ter.
# MAX_CONCURRENT_PER_IP=2

# Quantas requisições por minuto (por IP) as rotas /api/formats e /api/downloads aceitam.
# RATE_LIMIT_PER_MINUTE=20

# Espaço livre mínimo (MB) para aceitar um novo download. Em disco de 10GB use
# uma folga maior: um único vídeo longo em 1080p+ passa fácil de 1GB.
MIN_FREE_DISK_MB=2000

# Domínios aceitos, separados por vírgula. Por padrão só os sites mais comuns
# suportados pelo yt-dlp são liberados, pra evitar que o servidor vire um proxy
# aberto de downloads. Para liberar qualquer site, use ALLOW_ANY_DOMAIN=true.
# ALLOWED_DOMAINS=youtube.com,youtu.be,instagram.com,tiktok.com,twitter.com,x.com,facebook.com,fb.watch,vimeo.com,soundcloud.com
# ALLOW_ANY_DOMAIN=false
